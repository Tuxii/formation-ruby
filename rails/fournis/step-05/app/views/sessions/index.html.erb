<% content_for :title, "Toutes les sessions" %>

<h1 class="h2 mb-4">Toutes les sessions</h1>

<% if @sessions.any? %>
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>Date</th>
        <th>Atelier</th>
        <th class="text-end">Capacité</th>
        <th>Statut</th>
      </tr>
    </thead>
    <tbody id="sessions">
      <%= render @sessions %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">Aucune session programmée.</p>
<% end %>
