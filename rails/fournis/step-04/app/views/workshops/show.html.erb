<% content_for :title, @workshop.title %>

<nav aria-label="Fil d'Ariane">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Catalogue", workshops_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @workshop.title %></li>
  </ol>
</nav>

<div class="d-flex align-items-center gap-3 mb-3">
  <h1 class="h2 mb-0"><%= @workshop.title %></h1>
  <%= publication_badge(@workshop) %>
</div>

<% if @workshop.formatted_duration %>
  <p class="text-muted">Durée : <%= @workshop.formatted_duration %></p>
<% end %>

<%= simple_format(@workshop.description) %>

<div class="d-flex gap-2 mt-4">
  <%= link_to "Modifier", edit_workshop_path(@workshop), class: "btn btn-outline-secondary" %>
  <%= button_to "Supprimer", @workshop, method: :delete, class: "btn btn-outline-danger" %>
</div>
