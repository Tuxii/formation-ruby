<%= form_with url: sessions_path, method: :get, class: "row g-2 align-items-end mb-4" do |form| %>
  <div class="col-md-4">
    <%= form.label :workshop_id, "Atelier", class: "form-label" %>
    <%= form.collection_select :workshop_id, Workshop.order(:title), :id, :title,
          { include_blank: "Tous les ateliers", selected: params[:workshop_id] }, class: "form-select" %>
  </div>

  <div class="col-md-3">
    <%= form.label :status, "Statut", class: "form-label" %>
    <%= form.select :status, status_options, { include_blank: "Tous les statuts", selected: params[:status] }, class: "form-select" %>
  </div>

  <div class="col-md-3">
    <div class="form-check">
      <%= form.checkbox :upcoming, { checked: params[:upcoming] == "1", class: "form-check-input" } %>
      <%= form.label :upcoming, "À venir", class: "form-check-label" %>
    </div>
  </div>

  <div class="col-md-2 d-grid gap-1">
    <%= form.submit "Filtrer", name: nil, class: "btn btn-primary" %>
    <%= link_to "Tout afficher", sessions_path, class: "btn btn-link btn-sm" %>
  </div>
<% end %>
